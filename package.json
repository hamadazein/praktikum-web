{
  "name": "praktika-web-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write index.html assets/styles.css assets/js scripts tests package.json playwright.config.mjs",
    "format:check": "prettier --check index.html assets/styles.css assets/js scripts tests package.json playwright.config.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "dompurify": "3.4.15",
    "marked": "18.0.11",
    "prettier": "3.9.6"
  }
}
